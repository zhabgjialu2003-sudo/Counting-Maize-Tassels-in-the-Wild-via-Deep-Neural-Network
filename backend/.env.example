PGHOST=localhost
PGPORT=5432
PGDATABASE=maize_detector
PGUSER=postgres
PGPASSWORD=change-me
PGCONNECT_TIMEOUT=3
PGSTATEMENT_TIMEOUT_MS=5000
PG_DUMP_PATH=C:\PostgreSQL\18\bin\pg_dump.exe
PSQL_PATH=C:\PostgreSQL\18\bin\psql.exe
PG_RESTORE_PATH=C:\PostgreSQL\18\bin\pg_restore.exe
SECRET_KEY=replace-with-a-long-random-secret
FILE_ENCRYPTION_KEY=generate-with-Fernet.generate_key()
CORS_ALLOWED_ORIGINS=null,http://localhost:8000,http://127.0.0.1:8000,https://zhabgjialu2003-sudo.github.io
TOKEN_MAX_AGE_SECONDS=28800
AUTO_BACKUP_INTERVAL_HOURS=24
APP_ENV=production
# Leave false in normal use. Set true only to evaluate a disease artifact whose
# metadata says deployment_ready=false.
DISEASE_ALLOW_CANDIDATE=false
