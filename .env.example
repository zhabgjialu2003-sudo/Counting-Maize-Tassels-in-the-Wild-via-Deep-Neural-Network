# Copy this file to .env and provide local values. Never commit .env.
PGHOST=localhost
PGPORT=5432
PGDATABASE=maize_detector
PGUSER=postgres
PGPASSWORD=replace-with-your-local-password
SECRET_KEY=replace-with-a-long-random-value
FILE_ENCRYPTION_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
AUTO_MIGRATE=false
WAITRESS_HOST=127.0.0.1
WAITRESS_PORT=5000
WAITRESS_THREADS=4
MODEL_ROOTS=models
DATASET_ROOTS=datasets
MAX_IMAGE_BYTES=12582912
MAX_DATASET_BYTES=52428800
